<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TVMovieTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
    </style>
    <style name="Theme.TVMovieTracker.Amoled" parent="Theme.TVMovieTracker">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <!-- Complementary accent for devices without dynamic colors (Android 11 and older) -->
        <item name="colorPrimary">@color/amoled_accent</item>
        <item name="colorOnPrimary">#000000</item>
    </style>

    <!-- Dynamic (wallpaper) colors for the AMOLED theme: keep pure-black
         surfaces, take the accent from the wallpaper. -->
    <style name="ThemeOverlay.TVMovieTracker.AmoledDynamic" parent="ThemeOverlay.Material3.DynamicColors.Dark">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceVariant">#000000</item>
        <item name="colorSurfaceContainer">#000000</item>
        <item name="colorSurfaceContainerLow">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerHigh">#000000</item>
        <item name="colorSurfaceContainerHighest">#000000</item>
        <item name="colorSurfaceBright">#000000</item>
        <item name="colorSurfaceDim">#000000</item>
    </style>
</resources>
